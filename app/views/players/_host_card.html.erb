<div id="host_player_<%= player.id %>" class="bg-gray-800 rounded-2xl border <%= player.eliminated ? 'border-red-800 opacity-60 grayscale' : 'border-gray-700 hover:border-gray-500' %> overflow-hidden flex flex-col shadow-xl transition-all relative">
  
  <% if player.eliminated %>
    <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none bg-red-900/30 backdrop-blur-[1px]">
      <span class="text-red-500 font-black text-3xl md:text-4xl transform -rotate-12 uppercase border-4 border-red-500 px-6 py-2 bg-black/90 shadow-2xl tracking-widest">
        ИЗГНАН
      </span>
    </div>
  <% end %>

  <div class="bg-gray-700 p-4 flex justify-between items-center relative z-20 shadow-sm">
    <h2 class="text-base md:text-lg font-black text-white tracking-wide">Игрок <%= player.game.players.order(:id).index(player) + 1 %></h2>
    <a href="<%= game_player_path(player.game, player) %>" target="_blank" data-turbo="false" class="text-xs md:text-sm bg-blue-600 hover:bg-blue-500 text-white py-1.5 px-3 rounded-lg uppercase font-bold shadow transition">
      Ссылка
    </a>
  </div>

  <div class="px-5 py-3 text-xs md:text-sm bg-gray-900 flex justify-between items-center border-b border-gray-700">
    <span class="<%= player.biology_revealed ? 'text-gray-300 font-medium' : 'text-gray-600 italic' %>">
      <%= player.biology_revealed ? "#{player.gender}, #{player.age} л." : "Биология скрыта" %>
    </span>
    <% if player.biology_revealed %>
      <span class="<%= player.is_infertile ? 'text-red-500 bg-red-900/20 px-2 py-0.5 rounded' : 'text-green-400 bg-green-900/20 px-2 py-0.5 rounded' %> font-bold">
        <%= player.is_infertile ? "Ø Бесплодие" : "♥ Способен" %>
      </span>
    <% end %>
  </div>

  <div class="p-5 flex-grow space-y-4">
    <% player.ordered_player_cards.each do |pc| %>
      <div class="transition-opacity duration-500 <%= pc.revealed ? 'opacity-100' : 'opacity-30' %>">
        <span class="text-gray-500 uppercase font-black text-[10px] md:text-xs tracking-widest mb-0.5 block"><%= pc.card.category %></span>
        <div class="flex flex-wrap items-baseline gap-1.5 leading-tight">
          <span class="font-bold text-sm md:text-base <%= pc.revealed ? 'text-blue-300' : 'text-gray-500' %>">
            <%= pc.revealed ? pc.card.name : "[СКРЫТО]" %>
          </span>
          
          <% if pc.revealed %>
            <% if pc.card.category == 'health' && pc.severity %>
              <span class="text-red-400 font-black text-xs md:text-sm bg-red-900/20 px-1.5 rounded">[<%= pc.severity %>%]</span>
            <% end %>
            <% if pc.card.category == 'profession' && player.show_prof_exp? %>
              <span class="text-yellow-500/80 italic text-xs md:text-sm">(<%= player.profession_experience %> л.)</span>
            <% end %>
            <% if pc.card.category == 'hobby' && player.show_hobby_exp? %>
              <span class="text-green-500/80 italic text-xs md:text-sm">(<%= player.hobby_experience %> л.)</span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="p-4 bg-gray-900 border-t border-gray-700 mt-auto relative z-20">
    <% if player.eliminated %>
      <div class="text-center text-red-500 text-sm font-bold uppercase tracking-widest py-2 italic bg-red-900/10 rounded-lg">Вне бункера</div>
    <% elsif player.raid_status == 'raiding' %>
      <div class="bg-indigo-600/20 border border-indigo-500/50 text-indigo-400 text-xs md:text-sm text-center py-3 rounded-lg font-black uppercase tracking-widest animate-pulse">
        В ВЫЛАЗКЕ (Иммунитет)
      </div>
    <% else %>
      <%= button_to "Изгнать игрока", eliminate_game_player_path(player.game, player), method: :post, 
          data: { turbo_confirm: "Вы уверены? Игрок покинет игру." }, 
          class: "w-full py-3 bg-red-900 hover:bg-red-700 text-red-100 text-xs md:text-sm font-black uppercase tracking-widest rounded-lg transition-all shadow" %>
    <% end %>
  </div>
</div>
