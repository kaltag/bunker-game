<div id="<%= dom_id(player, :host) %>" class="panel overflow-hidden flex flex-col shadow-xl transition-all relative h-full <%= player.eliminated ? 'border-red-800 opacity-60 grayscale' : 'hover:border-gray-500' %>">

  <% if player.eliminated %>
    <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none bg-red-900/30 backdrop-blur-[2px]">
      <span class="text-red-500 font-black text-2xl sm:text-3xl md:text-4xl transform -rotate-12 uppercase border-4 border-red-500 px-4 sm:px-6 py-1.5 sm:py-2 bg-black/90 shadow-2xl tracking-widest">
        ИЗГНАН
      </span>
    </div>
  <% end %>

  <!-- Заголовок -->
  <div class="bg-gray-700 p-3 sm:p-4 flex justify-between items-center relative z-20 shadow-sm shrink-0 gap-2"
       <% if player.color.present? %>style="border-left: 4px solid <%= player.color %>"<% end %>>
    <div class="flex items-center gap-1.5 min-w-0">
      <% if player.avatar_emoji.present? %><span class="text-lg sm:text-xl shrink-0"><%= player.avatar_emoji %></span><% end %>
      <h2 class="text-sm sm:text-base md:text-lg font-black text-white tracking-wide truncate"><%= player.display_name %></h2>
    </div>
    <% if current_host? %>
      <a href="<%= game_player_path(player.game, player) %>" target="_blank" data-turbo="false" class="text-[10px] md:text-xs bg-blue-600 hover:bg-blue-500 text-white py-1.5 px-2.5 sm:px-3 rounded-lg uppercase font-bold shadow transition shrink-0">
        Ссылка
      </a>
    <% end %>
  </div>

  <!-- Биология -->
  <div class="px-3 sm:px-4 md:px-5 py-2.5 sm:py-3 text-xs bg-gray-900 flex justify-between items-center border-b border-gray-700 shrink-0 gap-2">
    <span class="<%= player.biology_revealed ? 'text-gray-300 font-medium' : 'text-gray-600 italic' %> truncate">
      <%= player.biology_revealed ? "#{player.gender}, #{player.age} л." : "Биология скрыта" %>
    </span>
    <% if player.biology_revealed %>
      <span class="<%= player.is_infertile ? 'text-red-500 bg-red-900/20' : 'text-green-400 bg-green-900/20' %> px-2 py-0.5 rounded text-[10px] sm:text-xs font-bold shrink-0">
        <%= player.is_infertile ? "Ø Бесплодие" : "♥ Способен" %>
      </span>
    <% end %>
  </div>

  <!-- Карточки -->
  <div class="p-3 sm:p-4 md:p-5 grow space-y-3 sm:space-y-4">
    <% player.ordered_player_cards.each do |pc| %>
      <div id="<%= dom_id(pc, :host) %>" class="transition-opacity duration-500 <%= pc.revealed ? 'opacity-100' : 'opacity-40' %>">
        <span class="text-gray-500 uppercase font-black text-[10px] md:text-xs tracking-widest mb-0.5 block"><%= pc.card.category %></span>
        <div class="flex flex-wrap items-center gap-1.5 leading-tight">
          <span class="font-bold text-sm md:text-base <%= pc.revealed ? 'text-blue-300' : 'text-gray-500' %>">
            <%= pc.revealed ? pc.card.name : "[СКРЫТО]" %>
          </span>

          <% if pc.revealed %>
            <% if pc.card.category == 'health' && pc.severity %>
              <span class="text-red-400 font-black text-[10px] md:text-xs bg-red-900/30 px-1.5 py-0.5 rounded-sm whitespace-nowrap">[<%= pc.severity %>%]</span>
            <% end %>
            <% if pc.card.category == 'profession' && player.show_prof_exp? %>
              <span class="text-yellow-500/80 italic text-[10px] md:text-xs whitespace-nowrap">(<%= player.profession_experience %> л.)</span>
            <% end %>
            <% if pc.card.category == 'hobby' && player.show_hobby_exp? %>
              <span class="text-green-500/80 italic text-[10px] md:text-xs whitespace-nowrap">(<%= player.hobby_experience %> л.)</span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Действие -->
  <div class="p-3 sm:p-4 bg-gray-900 border-t border-gray-700 mt-auto relative z-20 shrink-0">
    <% if player.eliminated %>
      <div class="text-center text-red-500 text-xs sm:text-sm font-bold uppercase tracking-widest py-2 italic bg-red-900/10 rounded-lg">Вне бункера</div>
    <% elsif player.raid_status == 'raiding' %>
      <div class="bg-indigo-600/20 border border-indigo-500/50 text-indigo-400 text-xs sm:text-sm text-center py-2.5 rounded-lg font-black uppercase tracking-widest animate-pulse">
        В ВЫЛАЗКЕ
      </div>
    <% elsif current_host? %>
      <%= button_to "Изгнать", eliminate_game_player_path(player.game, player), method: :post,
          data: { turbo_confirm: "Вы уверены? Игрок покинет игру." },
          class: "w-full py-2.5 md:py-3 bg-red-900/80 hover:bg-red-700 text-red-100 text-xs md:text-sm font-black uppercase tracking-widest rounded-lg transition-all shadow active:scale-[0.97]" %>
    <% end %>
  </div>
</div>
