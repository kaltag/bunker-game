<!-- app/views/players/_player_screen.html.erb -->
<div id="player_<%= player.id %>_screen" class="min-h-screen bg-black text-white p-4 font-sans pb-20">
  <div class="max-w-md mx-auto">
    
    <% if player.eliminated %>
      <div class="bg-red-600 text-white text-center p-4 rounded-lg font-black text-2xl mb-6 shadow-xl uppercase tracking-widest border-4 border-red-800 animate-pulse">
        ВЫ ИЗГНАНЫ
      </div>
      <p class="text-center text-gray-400 text-sm mb-6">Вы больше не можете вскрывать карты. Ваша игра окончена.</p>
    <% else %>
      <div class="text-center mb-6">
        <h1 class="text-3xl font-extrabold text-red-500">Ваше Досье</h1>
        <p class="text-xs text-gray-400 mt-1">Тщательно выбирайте, что вскрыть в этом раунде!</p>
      </div>

      <div class="bg-gray-800 p-3 rounded text-center mb-4 border border-gray-700">
        <span class="text-gray-400 text-xs uppercase font-bold">Доступно вскрытий сейчас:</span>
        <span class="text-blue-400 font-black text-lg ml-2">
          <%= [0, (game.current_round + 1) - player.total_revealed_count].max %>
        </span>
      </div>
    <% end %>

    <!-- Биология -->
    <div class="bg-gray-800 rounded-lg p-5 mb-4 border border-gray-700">
      <div class="flex justify-between items-center mb-3 border-b border-gray-700 pb-2">
        <h2 class="text-lg font-bold text-gray-300 uppercase">Биология</h2>
        <% if player.biology_revealed %>
          <span class="text-[10px] bg-green-600 text-white px-2 py-1 rounded font-bold tracking-widest">ВСКРЫТО</span>
        <% end %>
      </div>
      
      <div class="grid grid-cols-2 gap-4 text-sm mb-4">
        <div><span class="text-gray-500 block">Пол</span><span class="font-bold"><%= player.gender %></span></div>
        <div><span class="text-gray-500 block">Возраст</span><span class="font-bold"><%= player.age %></span></div>
        <div class="col-span-2">
          <span class="text-gray-500 block">Репродукция</span>
          <span class="font-bold <%= player.is_infertile ? 'text-red-400' : 'text-green-400' %>">
            <%= player.is_infertile ? 'Бесплодие' : 'Способен к деторождению' %>
          </span>
        </div>
      </div>

      <% unless player.biology_revealed %>
        <% if player.can_reveal_more? %>
          <%= button_to "Вскрыть всем", reveal_biology_game_player_path(game, player), method: :post, 
              class: "w-full py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-bold shadow-lg" %>
        <% else %>
          <p class="text-xs text-red-400 text-center bg-red-900/30 py-2 rounded">Лимит вскрытий на этот раунд исчерпан.</p>
        <% end %>
      <% end %>
    </div>

    <!-- Игровые Карты -->
    <div class="space-y-4">
      <% player.ordered_player_cards.each do |pc| %>
        <div class="bg-gray-800 rounded-lg p-4 border-l-4 <%= pc.revealed ? 'border-green-500' : 'border-blue-500' %>">
          
          <div class="flex justify-between items-start mb-2">
            <p class="text-xs text-gray-400 uppercase font-bold tracking-wider"><%= pc.card.category %></p>
            <% if pc.revealed %>
              <span class="text-[10px] bg-green-600 text-white px-2 py-1 rounded font-bold tracking-widest">ВСКРЫТО</span>
            <% end %>
          </div>
          
          <p class="text-xl font-bold">
            <%= pc.card.name %>
            
            <% if pc.card.category == 'profession' %>
              <span class="text-sm font-normal text-yellow-500 block sm:inline sm:ml-1">(Стаж: <%= player.profession_experience %> л.)</span>
            <% end %>
            <% if pc.card.category == 'hobby' %>
              <span class="text-sm font-normal text-green-500 block sm:inline sm:ml-1">(Стаж: <%= player.hobby_experience %> л.)</span>
            <% end %>
            <% if pc.card.category == 'health' && pc.severity %>
              <span class="text-sm font-bold text-red-400 block mt-1">Тяжесть: <%= pc.severity %>%</span>
            <% end %>
          </p>
          <p class="text-gray-300 text-sm mt-2 leading-tight"><%= pc.card.description %></p>
          
          <div class="mt-4">
            <% unless pc.revealed %>
              <% if player.can_reveal_more? %>
                <%= button_to "Вскрыть всем", reveal_game_player_player_card_path(game, player, pc), method: :post, 
                    class: "w-full py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-bold text-sm shadow-lg" %>
              <% else %>
                <p class="text-xs text-red-400 text-center bg-red-900/30 py-2 rounded">Лимит вскрытий исчерпан.</p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</div>
