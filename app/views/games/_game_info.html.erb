    <!-- Шапка игры -->
    <div id="<%= dom_id(game, :info) %>" class="panel p-4 sm:p-6 md:p-8 mb-6 md:mb-8">
      <div class="flex flex-col lg:flex-row justify-between items-start gap-6 lg:gap-8">
        <div class="flex-1 w-full min-w-0">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-red-500 mb-2 uppercase tracking-tight leading-tight">
            Катастрофа: <%= game.catastrophe&.name %>
          </h1>
          <p class="text-gray-300 text-sm md:text-base italic mb-5 md:mb-6 leading-relaxed max-w-4xl">
            "<%= game.catastrophe&.description %>"
          </p>

          <!-- Сетка бункера -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 text-sm md:text-base bg-gray-900 p-4 md:p-5 rounded-xl border border-gray-700">
            <div class="stat-block">
              <span class="text-gray-500 block uppercase text-[11px] sm:text-xs md:text-sm font-bold mb-1">Срок</span>
              <span class="text-xl md:text-2xl font-black text-yellow-500"><%= game.bunker_duration %> лет</span>
            </div>
            <div class="stat-block">
              <span class="text-gray-500 block uppercase text-[11px] sm:text-xs md:text-sm font-bold mb-1">Вместимость</span>
              <span class="text-xl md:text-2xl font-black text-red-500"><%= game.bunker_capacity %> / <%= game.players.count %></span>
            </div>
            <div class="stat-block">
              <span class="text-gray-500 block uppercase text-[11px] sm:text-xs md:text-sm font-bold mb-1">Ресурсы</span>
              <span class="text-base md:text-lg font-semibold text-gray-200 leading-tight block"><%= game.bunker_supplies %></span>
            </div>
            <div class="stat-block">
              <span class="text-gray-500 block uppercase text-[11px] sm:text-xs md:text-sm font-bold mb-1">Размер</span>
              <span class="text-base md:text-lg font-semibold text-gray-200 leading-tight block"><%= game.bunker_size %></span>
            </div>

            <!-- Особенности убежища -->
            <div class="col-span-2 md:col-span-4 bg-gray-800 p-4 rounded-xl border border-gray-700 mt-1">
              <span class="text-gray-400 uppercase text-[11px] sm:text-xs md:text-sm font-bold block mb-3">Особенности убежища</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 md:gap-3">
                <% game.bunker_features.each do |feature| %>
                  <div class="bg-gray-900 p-3 rounded-lg border border-gray-700/50">
                    <strong class="text-blue-300 text-sm md:text-base block mb-1"><%= feature['name'] %></strong>
                    <span class="text-gray-400 text-xs md:text-sm leading-relaxed"><%= feature['description'] %></span>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Внезапная Угроза -->
            <% if game.threat_revealed %>
              <div class="col-span-2 md:col-span-4 bg-red-900/30 p-4 md:p-5 rounded-xl border border-red-800/50 mt-1">
                <span class="text-red-400 uppercase text-sm font-bold block mb-2">
                  Угроза: <%= game.threat&.name %>
                </span>
                <span class="text-gray-200 text-sm md:text-base font-medium leading-relaxed">
                  "<%= game.threat&.description %>"
                </span>
              </div>
            <% else %>
              <div class="col-span-2 md:col-span-4 bg-red-900/20 p-4 md:p-5 rounded-xl border border-red-800/50 mt-1 flex flex-col sm:flex-row items-center justify-between gap-3">
                <span class="text-gray-500 text-xs font-bold uppercase tracking-widest">Внезапная угроза (Скрыто)</span>
                <% if current_host? %>
                  <%= button_to "АКТИВИРОВАТЬ", reveal_threat_game_path(game), method: :post,
                      class: "btn-game bg-red-600/20 hover:bg-red-600 border border-red-600 text-red-400 hover:text-white py-2.5 px-5 text-xs shrink-0" %>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Система рейдов -->
          <div id="<%= dom_id(game, :raid_system) %>" class="mt-6 md:mt-8">
            <div class="bg-indigo-900/20 border border-indigo-500/50 rounded-2xl p-4 sm:p-5 md:p-6">
              <% if game.raid_params_revealed %>

                <h3 class="text-indigo-400 font-black uppercase text-base md:text-lg mb-4 flex items-center gap-2">
                  <span class="text-xl sm:text-2xl">🚀</span> Система рейдов
                </h3>

                <% if game.active_raid_id.present? %>
                  <% raid = Raid.find(game.active_raid_id) %>
                  <div class="bg-indigo-950/80 p-5 md:p-8 rounded-xl border border-indigo-400 border-dashed text-center">
                    <p class="text-white font-bold text-lg sm:text-xl md:text-2xl mb-2"><%= raid.name %></p>
                    <p class="text-indigo-300 text-sm md:text-base italic mb-4 max-w-2xl mx-auto leading-relaxed">"<%= raid.description %>"</p>
                    <div class="inline-block px-5 py-2 bg-indigo-600 text-white text-xs md:text-sm font-black rounded-full animate-pulse uppercase tracking-widest">
                      Группа на поверхности...
                    </div>
                  </div>
                <% else %>
                  <!-- Кандидаты на рейд -->
                  <div class="mb-5 p-4 bg-indigo-950/50 rounded-xl border border-indigo-800/50">
                    <p class="text-indigo-300 text-xs md:text-sm font-black uppercase mb-3 tracking-widest">Рандом выбрал вас (Голосуйте!):</p>
                    <div class="flex flex-wrap gap-2">
                      <% game.raid_candidates.each do |candidate| %>
                        <div class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold shadow">
                          <%= candidate.display_name %>
                          <span class="text-indigo-200 font-normal hidden sm:inline">
                            (<%= candidate.profession&.name || 'Профессия скрыта' %>)
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <!-- Форма выбора рейдеров (только для ведущего) -->
                  <% if current_host? %>
                    <%= form_with url: start_raid_game_path(game), method: :post, class: "space-y-4" do |f| %>
                      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-2.5 md:gap-3">
                        <% game.players.where(eliminated: false).each do |p| %>
                          <label class="relative cursor-pointer block">
                            <%= check_box_tag "raider_ids[]", p.id, false, class: "peer sr-only" %>
                            <div class="flex flex-col items-center justify-center p-3 md:p-4 rounded-xl border-2 border-indigo-900/50 bg-gray-900/50 peer-checked:bg-indigo-600 peer-checked:border-indigo-400 peer-checked:text-white peer-checked:shadow-[0_0_15px_rgba(79,70,229,0.5)] transition-all h-full text-gray-300">
                              <p class="text-xs md:text-sm font-medium text-center w-full truncate">
                                <%= p.display_name %>
                              </p>
                              <p class="text-[10px] md:text-xs font-bold text-indigo-400 truncate w-full text-center mt-1" title="<%= p.profession&.name || 'Скрыто' %>">
                                <%= p.profession&.name || 'Скрыто' %>
                              </p>
                              <!-- Галочка -->
                              <div class="absolute -top-1.5 -right-1.5 bg-indigo-400 text-white rounded-full p-0.5 opacity-0 peer-checked:opacity-100 transition-opacity shadow-lg">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                              </div>
                            </div>
                          </label>
                        <% end %>
                      </div>
                      <%= f.submit "ПОДТВЕРДИТЬ СОСТАВ И ОТПРАВИТЬ", class: "btn-game bg-indigo-600 hover:bg-indigo-500 text-white w-full py-4 md:py-5 mt-3" %>
                    <% end %>
                  <% else %>
                    <p class="text-indigo-300/60 text-sm text-center italic py-4">Ведущий выбирает состав группы...</p>
                  <% end %>
                <% end %>

              <% else %>
                <!-- Заглушка системы рейдов -->
                <div class="p-5 md:p-6 text-center">
                  <p class="text-gray-500 text-xs font-bold uppercase tracking-[0.2em] sm:tracking-[0.3em] mb-4">Внешние вылазки заблокированы</p>
                  <% if current_host? %>
                    <%= button_to "РАЗБЛОКИРОВАТЬ СИСТЕМУ РЕЙДОВ", reveal_raid_system_game_path(game), method: :post,
                        class: "btn-game bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-600 text-indigo-400 hover:text-white py-2.5 px-6 text-[11px] sm:text-xs" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- СВОДКА РЕЗУЛЬТАТОВ РЕЙДА -->
          <% recent_raiders = game.players.where.not(raid_outcome: nil).where.not(raid_status: 'raiding') %>
          <% if recent_raiders.any? %>
            <div class="mt-6 md:mt-8 bg-gray-900 border-2 border-indigo-500 rounded-2xl p-4 sm:p-5 md:p-6 shadow-[0_0_30px_rgba(99,102,241,0.15)]">
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 md:mb-5 gap-3">
                <h2 class="text-indigo-400 font-black uppercase tracking-widest text-sm md:text-base lg:text-lg">Итоги последней вылазки</h2>
                <% if current_host? %>
                  <%= button_to "ЗАКРЫТЬ ОТЧЕТ", clear_raid_report_game_path(game), method: :post, class: "btn-game bg-gray-700 text-white py-2 px-4 text-xs hover:bg-gray-600 shrink-0" %>
                <% end %>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
                <% recent_raiders.each do |p| %>
                  <div id="<%= dom_id(p, :raid_result) %>" class="flex flex-col gap-2 p-4 rounded-xl bg-gray-800 border-l-4 shadow-md <%= p.raid_status == 'dead' ? 'border-red-600' : 'border-green-500' %>">
                    <div class="font-black text-indigo-300 text-sm md:text-base">
                       <%= p.display_name %>:
                    </div>
                    <div class="text-sm md:text-base text-gray-300 leading-snug">
                      <span class="font-black uppercase text-xs mr-1 inline-block <%= p.raid_status == 'dead' ? 'text-red-500 bg-red-900/30 px-2 py-0.5 rounded' : 'text-green-400 bg-green-900/30 px-2 py-0.5 rounded' %>">
                        <%= p.raid_status.humanize %>
                      </span>
                      <%= p.raid_outcome %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

        </div>

        <!-- Правая панель (Статус игры) -->
        <div id="<%= dom_id(game, :status) %>" class="flex flex-col gap-3 md:gap-4 w-full lg:w-72 xl:w-80 shrink-0">
          <div class="bg-gray-700 p-4 md:p-5 rounded-2xl border border-gray-600 shadow-inner text-center lg:text-right">
            <p class="text-gray-400 text-xs uppercase font-bold tracking-widest mb-1">Код партии</p>
            <p class="text-3xl md:text-4xl font-mono font-black text-white tracking-widest select-all"><%= game.code %></p>
            <% unless current_host? %>
              <p class="text-gray-500 text-[10px] sm:text-xs mt-2 uppercase tracking-wider font-bold">Игровая доска</p>
            <% end %>
          </div>
          <% if current_host? %>
            <a href="<%= board_game_path(game) %>" target="_blank" data-turbo="false" class="block bg-gray-800 hover:bg-gray-700 p-3 md:p-4 rounded-2xl border border-gray-600 text-center transition-colors">
              <p class="text-gray-400 text-[10px] sm:text-xs uppercase font-bold tracking-widest mb-1">Доска для игроков</p>
              <p class="text-blue-400 text-xs sm:text-sm font-bold truncate"><%= board_game_url(game) %></p>
            </a>
          <% end %>

          <div class="bg-gray-900 p-4 sm:p-5 md:p-6 rounded-2xl border border-gray-700 flex flex-col justify-center text-center lg:text-right">
            <p class="text-gray-400 text-sm md:text-base uppercase font-bold mb-2">Раунд: <span class="text-white text-2xl md:text-3xl ml-2"><%= game.current_round %> / 5</span></p>

            <% if game.current_round <= 5 %>
              <% if game.total_remaining_eliminations > 0 %>
                <div class="bg-red-900/20 rounded-xl p-3 mb-4 mt-2 border border-red-900/50">
                  <p class="text-red-400 text-sm md:text-base font-bold">
                    Изгнать сейчас: <span class="text-white text-xl md:text-2xl font-black ml-1"><%= game.eliminations_this_round %></span>
                  </p>
                  <p class="text-gray-500 text-xs uppercase font-bold mt-2">
                    Всего лишних: <%= game.total_remaining_eliminations %>
                  </p>
                </div>
              <% else %>
                <p class="text-green-500 text-sm sm:text-base md:text-lg font-black my-4 uppercase tracking-wider bg-green-900/20 py-2 rounded-xl">Состав идеален!</p>
              <% end %>

              <% if current_host? %>
                <%= button_to "СЛЕДУЮЩИЙ РАУНД", reveal_next_round_game_path(game), method: :post,
                    class: "btn-primary w-full" %>
              <% end %>

            <% else %>
              <!-- ФИНАЛ -->
              <div class="text-green-500 font-black uppercase text-xl sm:text-2xl md:text-3xl mt-2 animate-pulse mb-4">ДВЕРИ ЗАКРЫТЫ</div>

              <% if game.total_remaining_eliminations > 0 %>
                <div class="bg-red-900/30 p-4 rounded-xl border border-red-700 mb-4">
                  <p class="text-red-400 text-sm font-bold leading-relaxed">В бункере остались лишние! Изгоните ещё <%= game.total_remaining_eliminations %></p>
                </div>
              <% else %>
                <p class="text-gray-300 text-sm md:text-base mb-5 italic">Группа сформирована. Тайны заперты внутри.</p>
                <% if current_host? %>
                  <%= link_to "ГЕНЕРАЦИЯ ИСТОРИИ", report_game_path(game),
                      class: "btn-action w-full block text-center" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <% if Rails.env.development? && current_host? %>
      <div class="flex flex-wrap gap-2 mt-4">
        <%= button_to "DEV: Вскрыть все карты", dev_reveal_all_game_path(game), method: :post,
            class: "btn-game bg-gray-700 hover:bg-gray-600 text-gray-300 py-2 px-4 text-xs" %>
        <%= button_to "DEV: Следующий раунд (×3)", reveal_next_round_game_path(game), method: :post,
            class: "btn-game bg-gray-700 hover:bg-gray-600 text-gray-300 py-2 px-4 text-xs" %>
      </div>
    <% end %>

    <!-- Хроника партии (лог событий) -->
    <% events = game.game_events.chronological %>
    <% if events.any? %>
      <div class="panel p-4 sm:p-5 md:p-6 mt-6 md:mt-8">
        <h2 class="text-sm md:text-base font-black text-gray-400 uppercase tracking-widest mb-3">Хроника партии</h2>
        <div class="max-h-48 md:max-h-64 overflow-y-auto space-y-1.5 pr-2 scrollbar-thin">
          <% events.each do |event| %>
            <div class="flex gap-2 text-xs sm:text-sm leading-relaxed">
              <span class="text-gray-600 font-mono font-bold shrink-0">[R<%= event.round || '?' %>]</span>
              <span class="<%= event.event_type == 'player_eliminated' ? 'text-red-400' : event.event_type == 'threat_revealed' ? 'text-yellow-400' : 'text-gray-300' %>">
                <%= event.description %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
