<!-- app/views/games/new.html.erb -->
<div class="min-h-screen bg-gray-900 flex flex-col items-center justify-center text-white p-4">
  <div class="max-w-md w-full bg-gray-800 rounded-xl shadow-2xl p-8 text-center border border-gray-700">
    <h1 class="text-4xl font-extrabold text-red-500 mb-2 uppercase tracking-tighter">БУНКЕР</h1>
    <p class="text-gray-400 mb-8">Цифровой помощник ведущего</p>

    <%= form_with url: games_path, method: :post, local: true, class: "space-y-6" do |f| %>
      <div class="text-left">
        <label class="block text-sm font-medium text-gray-400 mb-2">Количество игроков:</label>
        <%= f.select :player_count, (6..16).to_a, { selected: 8 }, 
            class: "w-full bg-gray-700 border-gray-600 text-white rounded-lg py-3 px-4 focus:ring-red-500 focus:border-red-500" %>
      </div>

      <p class="text-xs text-gray-500 italic">
        Система сбалансирует персонажей, синергии и биологические статы под выбранное количество людей.
      </p>

      <%= f.submit "СГЕНЕРИРОВАТЬ ПАРТИЮ", 
          class: "w-full bg-red-600 hover:bg-red-700 text-white font-bold py-4 px-6 rounded-lg transition duration-200 cursor-pointer shadow-lg" %>
    <% end %>
  </div>
</div>